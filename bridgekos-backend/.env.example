# ------------------------------------------------------------------
# BridgeKos Backend Environment (template)
# Copy to .env and fill in your own values.
# ------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
APP_NAME=BridgeKos

# Database
# Development (SQLite). Relative to prisma/ directory.
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) - used when NODE_ENV=production
DATABASE_URL_PROD="postgresql://postgres:password@localhost:5432/bridgekos?schema=public"

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Argon2
PASSWORD_HASH_MEMORY=65536
PASSWORD_HASH_TIME=3
PASSWORD_HASH_PARALLELISM=1

# Uploads
UPLOAD_DIR=./storage
UPLOAD_MAX_SIZE_MB=5
STORAGE_DRIVER=local

# S3 (future)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Email (placeholder)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@bridgekos.id